#!/usr/bin/env php
<?php // bin/kip

try {
    require __DIR__ . '/../vendor/autoload.php';
    $config = require __DIR__ . '/../config.php';

    // Feature folders (ch. 3): migrations live in the app directory AND in every
    // app/Features/<Name>/migrations. Discovered LAZILY, only in the migration
    // commands, so a broken Features layout never breaks logs/backup/help. scandir()
    // over the Features directory, never glob() (it reads app_dir as pattern text,
    // so a metacharacter path silently lists nothing). Anything that EXISTS under a
    // feature is passed through: Migrator::files() fails loudly on a migrations
    // path that is not a readable directory, instead of quietly skipping it.
    $migration_dirs = static function () use ($config): array {
        $dirs = [$config['app_dir'] . '/migrations'];
        $features_dir = $config['app_dir'] . '/Features';
        if (!is_dir($features_dir) && !is_link($features_dir) && !file_exists($features_dir)) return $dirs;
        error_clear_last();
        $entries = @scandir($features_dir);
        if ($entries === false) {
            $why = error_get_last()['message'] ?? 'unknown error';
            throw new RuntimeException("Cannot list {$features_dir}: {$why}. Refusing to migrate a partial inventory as a complete batch.");
        }
        foreach ($entries as $entry) {
            if ($entry[0] === '.') continue;
            $m = $features_dir . '/' . $entry . '/migrations';
            if (is_dir($m) || is_link($m) || file_exists($m)) $dirs[] = $m;
        }
        return $dirs;
    };

    match ($argv[1] ?? 'help') {
    'migrate' => (function () use ($config, $migration_dirs) {
        $db = new Kip\Database($config['db']['dsn']);
        $log = new Kip\RequestLog(new Kip\Database($config['log_db']['dsn']), $config['log_db']['retention_days'] ?? 30);
        $log->pruneToRetention();
        $ran = (new Kip\Migrations\Migrator($db, $migration_dirs()))->migrate();
        echo $ran ? 'Ran: ' . implode(', ', $ran) . "\n" : "Nothing to migrate.\n";
    })(),
    'rollback' => (function () use ($config, $migration_dirs) { // review 4A
        $db = new Kip\Database($config['db']['dsn']);
        $undone = (new Kip\Migrations\Migrator($db, $migration_dirs()))->rollback();
        echo $undone ? 'Rolled back: ' . implode(', ', $undone) . "\n" : "Nothing to roll back.\n";
    })(),
    'serve' => (function () use ($config, $migration_dirs) {
        $ran = (new Kip\Migrations\Migrator(new Kip\Database($config['db']['dsn']), $migration_dirs()))->migrate();
        if ($ran) echo 'Auto-migrated: ' . implode(', ', $ran) . "\n";
        passthru('KIP_ENV=dev php -S localhost:8080 -t ' . escapeshellarg(__DIR__ . '/../public'));
    })(),
    'user:create' => (function () use ($config, $argv) {
        $rest    = array_slice($argv, 2);
        $isAdmin = in_array('--admin', $rest, true);
        $rest    = array_values(array_filter($rest, static fn(string $a): bool => $a !== '--admin'));
        $email    = $rest[0] ?? '';
        $password = $rest[1] ?? null;
        if ($email === '') {
            fwrite(STDERR, "Usage: kip user:create <email> [password] [--admin]\n");
            exit(1);
        }
        if ($password === null) {                       // QA T8: keep secrets out of shell history / ps
            fwrite(STDOUT, "Password (input hidden): ");
            if (function_exists('shell_exec') && stripos(PHP_OS_FAMILY, 'Windows') === false) {
                shell_exec('stty -echo 2>/dev/null');
                $password = rtrim((string) fgets(STDIN), "\n");
                shell_exec('stty echo 2>/dev/null');
                fwrite(STDOUT, "\n");
            } else {
                $password = rtrim((string) fgets(STDIN), "\n"); // visible fallback (Windows / no stty)
            }
        }
        if (strlen($password) < 8) {
            fwrite(STDERR, "Password must be at least 8 characters (matches the reset flow).\n");
            exit(1);
        }
        if (str_contains($password, "\0")) {
            fwrite(STDERR, "Password cannot contain a NUL byte.\n");
            exit(1);
        }
        $db = new Kip\Database($config['db']['dsn']);
        $store = [];
        $auth = new Kip\Auth($db, new Kip\Session($store));
        try {
            $auth->register($email, $password);
        } catch (\PDOException $e) {
            if (str_contains($e->getMessage(), 'UNIQUE')) {
                fwrite(STDERR, "A user with email {$email} already exists.\n");
                exit(1);
            }
            throw $e;
        }
        if ($isAdmin) {
            try {
                $db->query('UPDATE users SET is_admin = 1 WHERE email = ?', [$email]);
            } catch (\PDOException) {
                fwrite(STDERR, "User created, but users.is_admin is missing, run the add_users_is_admin migration first.\n");
                exit(1);
            }
        }
        echo "User {$email} created" . ($isAdmin ? ' (admin)' : '') . ".\n";
    })(),
    'logs' => (function () use ($config) {
        $log = new Kip\RequestLog(new Kip\Database($config['log_db']['dsn']), $config['log_db']['retention_days'] ?? 30);
        $log->pruneToRetention();
        foreach (array_reverse($log->recent(50)) as $r) {
            $user = $r['user_id'] !== null ? "user:{$r['user_id']}" : 'guest';
            printf("%s %3d %-6s %-40s %6.1fms %-15s %s\n", $r['created_at'], $r['status'], $r['method'], $r['path'], $r['duration_ms'], $r['ip'], $user);
        }
    })(),
    'logs:prune' => (function () use ($config, $argv) {
        $arg = $argv[2] ?? '--days=30';
        if (!preg_match('/^--days=(\d+)$/', $arg, $m) || (int) $m[1] < 1) {
            fwrite(STDERR, "Usage: kip logs:prune --days=<positive integer>\n");
            exit(1);
        }
        $days = (int) $m[1];
        $log = new Kip\RequestLog(new Kip\Database($config['log_db']['dsn']));
        printf("Pruned %d rows older than %d days.\n", $log->prune($days), $days);
    })(),
    'backup' => (function () use ($config) {
        // Off-site uploads: all five KIP_BACKUP_S3_* vars or none. A
        // set-but-incomplete combination is a cron typo, and it must fail
        // loudly BEFORE any backup is written, never silently fall back to
        // local-only backups. An empty value counts as unset.
        $s3Env = [
            'KIP_BACKUP_S3_ENDPOINT' => 'endpoint',
            'KIP_BACKUP_S3_REGION' => 'region',
            'KIP_BACKUP_S3_BUCKET' => 'bucket',
            'KIP_BACKUP_S3_KEY' => 'key',
            'KIP_BACKUP_S3_SECRET' => 'secret',
        ];
        $set = array_filter($s3Env, static fn(string $envName): bool => (string) getenv($envName) !== '', ARRAY_FILTER_USE_KEY);
        if ($set !== [] && count($set) !== count($s3Env)) {
            $missing = implode(', ', array_keys(array_diff_key($s3Env, $set)));
            throw new RuntimeException("Incomplete off-site backup configuration, missing KIP_BACKUP_S3_* vars: {$missing}. "
                . 'A half-configured cron must fail loudly, never silently fall back to local-only backups.');
        }
        $s3 = null;
        if ($set !== []) {
            $s3Config = [];
            foreach ($set as $envName => $configKey) $s3Config[$configKey] = (string) getenv($envName);
            $prefix = getenv('KIP_BACKUP_S3_PREFIX');
            if (is_string($prefix) && $prefix !== '') $s3Config['prefix'] = $prefix;
            $s3 = new Kip\S3($s3Config);
        }
        $result = (new Kip\Backup(array_filter([
            'data'  => $config['db']['dsn'] ?? null,
            'logs'  => $config['log_db']['dsn'] ?? null,
            'cache' => $config['cache_db']['dsn'] ?? null,
        ]), $config['app_dir'] . '/backups', 14, $s3))->run(date('Ymd-His'));
        echo "Backup written: {$result}\n";
    })(),
    default => print("Usage: kip [migrate|rollback|serve|logs|logs:prune|backup|user:create <email> [password] [--admin]]\n"),
    };
} catch (\Throwable $e) {
    // A failed deploy needs a stated failure, not a stack trace on stdout.
    // Exit 1 matches every argument-validation arm; docs/guide/08-cli.md owns
    // the contract.
    fwrite(STDERR, 'kip: ' . $e::class . ': ' . $e->getMessage() . \PHP_EOL);
    exit(1);
}
