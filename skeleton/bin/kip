#!/usr/bin/env php
<?php // bin/kip

try {
    require __DIR__ . '/../vendor/autoload.php';
    $config = require __DIR__ . '/../config.php';

    // Feature folders (ch. 3): migrations live in the app directory AND in every
    // app/Features/<Name>/migrations. Discovered LAZILY, only in the migration
    // commands, so a broken Features layout never breaks logs/backup/help. scandir()
    // over the Features directory, never glob() (it reads app_dir as pattern text,
    // so a metacharacter path silently lists nothing). Anything that EXISTS under a
    // feature is passed through: Migrator::files() fails loudly on a migrations
    // path that is not a readable directory, instead of quietly skipping it.
    $migration_dirs = static function () use ($config): array {
        $dirs = [$config['app_dir'] . '/migrations'];
        $features_dir = $config['app_dir'] . '/Features';
        if (!is_dir($features_dir) && !is_link($features_dir) && !file_exists($features_dir)) return $dirs;
        error_clear_last();
        $entries = @scandir($features_dir);
        if ($entries === false) {
            $why = error_get_last()['message'] ?? 'unknown error';
            throw new RuntimeException("Cannot list {$features_dir}: {$why}. Refusing to migrate a partial inventory as a complete batch.");
        }
        foreach ($entries as $entry) {
            if ($entry[0] === '.') continue;
            $m = $features_dir . '/' . $entry . '/migrations';
            if (is_dir($m) || is_link($m) || file_exists($m)) $dirs[] = $m;
        }
        return $dirs;
    };

    // The plain-controller directory for make:controller and make:feature's
    // shadowing guard: where the app's own autoloader maps the controller
    // namespace (composer.json psr-4, longest prefix, the Composer rule),
    // falling back to the documented convention app/src/Controllers when
    // there is no composer.json to read. An unmapped or ambiguously mapped
    // namespace is a refusal, never a guess.
    $plain_controller_dir = static function () use ($config): string {
        $namespace = $config['controller_namespace'] ?? 'App\\Controllers\\';
        if (!is_string($namespace)) {
            throw new RuntimeException('config controller_namespace must be a namespace prefix string.');
        }
        $composer = dirname(__DIR__) . '/composer.json';
        if (is_file($composer)) {
            $paths = Kip\Scaffold::autoloadPaths($composer, $namespace . 'Placement');
            if (count($paths) > 1) {
                throw new RuntimeException("composer.json maps {$namespace} to more than one directory; kip make: refuses to guess. Disambiguate the psr-4 mapping or scaffold by hand.");
            }
            if ($paths !== []) return dirname($paths[0]);
            throw new RuntimeException("composer.json maps no psr-4 prefix covering {$namespace}; fix autoload before scaffolding.");
        }
        if ($namespace === 'App\\Controllers\\') return $config['app_dir'] . '/src/Controllers';
        throw new RuntimeException("no composer.json to resolve {$namespace} from; kip make:controller places the default App\\Controllers\\ in app/src/Controllers (guide ch. 3).");
    };

    match ($argv[1] ?? 'help') {
    'migrate' => (function () use ($config, $migration_dirs) {
        $db = new Kip\Database($config['db']['dsn']);
        $log = new Kip\RequestLog(new Kip\Database($config['log_db']['dsn']), $config['log_db']['retention_days'] ?? 30);
        $log->pruneToRetention();
        $ran = (new Kip\Migrations\Migrator($db, $migration_dirs()))->migrate();
        echo $ran ? 'Ran: ' . implode(', ', $ran) . "\n" : "Nothing to migrate.\n";
    })(),
    'rollback' => (function () use ($config, $migration_dirs) { // review 4A
        $db = new Kip\Database($config['db']['dsn']);
        $undone = (new Kip\Migrations\Migrator($db, $migration_dirs()))->rollback();
        echo $undone ? 'Rolled back: ' . implode(', ', $undone) . "\n" : "Nothing to roll back.\n";
    })(),
    'serve' => (function () use ($config, $migration_dirs) {
        $ran = (new Kip\Migrations\Migrator(new Kip\Database($config['db']['dsn']), $migration_dirs()))->migrate();
        if ($ran) echo 'Auto-migrated: ' . implode(', ', $ran) . "\n";
        passthru('KIP_ENV=dev php -S localhost:8080 -t ' . escapeshellarg(__DIR__ . '/../public'));
    })(),
    'user:create' => (function () use ($config, $argv) {
        $rest    = array_slice($argv, 2);
        $isAdmin = in_array('--admin', $rest, true);
        $rest    = array_values(array_filter($rest, static fn(string $a): bool => $a !== '--admin'));
        $email    = $rest[0] ?? '';
        $password = $rest[1] ?? null;
        if ($email === '') {
            fwrite(STDERR, "Usage: kip user:create <email> [password] [--admin]\n");
            exit(1);
        }
        if ($password === null) {                       // QA T8: keep secrets out of shell history / ps
            fwrite(STDOUT, "Password (input hidden): ");
            if (function_exists('shell_exec') && stripos(PHP_OS_FAMILY, 'Windows') === false) {
                shell_exec('stty -echo 2>/dev/null');
                $password = rtrim((string) fgets(STDIN), "\n");
                shell_exec('stty echo 2>/dev/null');
                fwrite(STDOUT, "\n");
            } else {
                $password = rtrim((string) fgets(STDIN), "\n"); // visible fallback (Windows / no stty)
            }
        }
        if (strlen($password) < 8) {
            fwrite(STDERR, "Password must be at least 8 characters (matches the reset flow).\n");
            exit(1);
        }
        if (str_contains($password, "\0")) {
            fwrite(STDERR, "Password cannot contain a NUL byte.\n");
            exit(1);
        }
        $db = new Kip\Database($config['db']['dsn']);
        $store = [];
        $auth = new Kip\Auth($db, new Kip\Session($store));
        try {
            $auth->register($email, $password);
        } catch (\PDOException $e) {
            if (str_contains($e->getMessage(), 'UNIQUE')) {
                fwrite(STDERR, "A user with email {$email} already exists.\n");
                exit(1);
            }
            throw $e;
        }
        if ($isAdmin) {
            try {
                $db->query('UPDATE users SET is_admin = 1 WHERE email = ?', [$email]);
            } catch (\PDOException) {
                fwrite(STDERR, "User created, but users.is_admin is missing, run the add_users_is_admin migration first.\n");
                exit(1);
            }
        }
        echo "User {$email} created" . ($isAdmin ? ' (admin)' : '') . ".\n";
    })(),
    'logs' => (function () use ($config) {
        $log = new Kip\RequestLog(new Kip\Database($config['log_db']['dsn']), $config['log_db']['retention_days'] ?? 30);
        $log->pruneToRetention();
        foreach (array_reverse($log->recent(50)) as $r) {
            $user = $r['user_id'] !== null ? "user:{$r['user_id']}" : 'guest';
            printf("%s %3d %-6s %-40s %6.1fms %-15s %s\n", $r['created_at'], $r['status'], $r['method'], $r['path'], $r['duration_ms'], $r['ip'], $user);
        }
    })(),
    'logs:prune' => (function () use ($config, $argv) {
        $arg = $argv[2] ?? '--days=30';
        if (!preg_match('/^--days=(\d+)$/', $arg, $m) || (int) $m[1] < 1) {
            fwrite(STDERR, "Usage: kip logs:prune --days=<positive integer>\n");
            exit(1);
        }
        $days = (int) $m[1];
        $log = new Kip\RequestLog(new Kip\Database($config['log_db']['dsn']));
        printf("Pruned %d rows older than %d days.\n", $log->prune($days), $days);
    })(),
    'backup' => (function () use ($config) {
        // Off-site uploads: all five KIP_BACKUP_S3_* vars or none. A
        // set-but-incomplete combination is a cron typo, and it must fail
        // loudly BEFORE any backup is written, never silently fall back to
        // local-only backups. An empty value counts as unset.
        $s3Env = [
            'KIP_BACKUP_S3_ENDPOINT' => 'endpoint',
            'KIP_BACKUP_S3_REGION' => 'region',
            'KIP_BACKUP_S3_BUCKET' => 'bucket',
            'KIP_BACKUP_S3_KEY' => 'key',
            'KIP_BACKUP_S3_SECRET' => 'secret',
        ];
        $set = array_filter($s3Env, static fn(string $envName): bool => (string) getenv($envName) !== '', ARRAY_FILTER_USE_KEY);
        if ($set !== [] && count($set) !== count($s3Env)) {
            $missing = implode(', ', array_keys(array_diff_key($s3Env, $set)));
            throw new RuntimeException("Incomplete off-site backup configuration, missing KIP_BACKUP_S3_* vars: {$missing}. "
                . 'A half-configured cron must fail loudly, never silently fall back to local-only backups.');
        }
        $s3 = null;
        if ($set !== []) {
            $s3Config = [];
            foreach ($set as $envName => $configKey) $s3Config[$configKey] = (string) getenv($envName);
            $prefix = getenv('KIP_BACKUP_S3_PREFIX');
            if (is_string($prefix) && $prefix !== '') $s3Config['prefix'] = $prefix;
            $s3 = new Kip\S3($s3Config);
        }
        $result = (new Kip\Backup(array_filter([
            'data'  => $config['db']['dsn'] ?? null,
            'logs'  => $config['log_db']['dsn'] ?? null,
            'cache' => $config['cache_db']['dsn'] ?? null,
        ]), $config['app_dir'] . '/backups', 14, $s3))->run(date('Ymd-His'));
        echo "Backup written: {$result}\n";
    })(),
    'queue:work' => (function () use ($config, $argv) {
        // The durable-jobs runner (Kip\Jobs, guide ch. 8). Any flag other than
        // --once is a usage error: a typo like --onces must never fall through
        // into the infinite worker loop by accident.
        $rest = array_slice($argv, 2);
        if ($rest !== array_values(array_filter($rest, static fn(string $a): bool => $a === '--once'))) {
            fwrite(STDERR, "Usage: kip queue:work [--once]\n");
            exit(1);
        }
        $once = in_array('--once', $rest, true);
        $jobs = new Kip\Jobs(new Kip\Database($config['db']['dsn']));
        if (!$once) echo "Working the jobs queue, Ctrl+C to stop.\n";
        // One job per claim, marked done or failed in its own row. Storage
        // trouble (an acknowledgment that fails) throws and lands in the
        // shared catch below; a job's own failure stays in the row. --once is
        // the cron/systemd shape: one job, then an exit code cron can read.
        while (true) {
            $row = $jobs->runNext();
            if ($row === null) {
                if ($once) { echo "No pending jobs.\n"; exit(0); }
                sleep(1);
                continue;
            }
            if ($row['status'] === 'failed') {
                fwrite(STDERR, sprintf('kip: job #%d (%s) failed: %s' . \PHP_EOL, $row['id'], $row['job_class'], $row['error']));
                if ($once) exit(1);
            } else {
                echo sprintf("Job #%d %s: done\n", $row['id'], $row['job_class']);
                if ($once) exit(0);
            }
        }
    })(),
    'db' => (function () use ($config, $argv) {
        // Read-only queries against the app database. The connection is opened
        // DIRECTLY from the configured DSN on a second handle SQLite itself
        // opens read-only (SQLITE_OPEN_READONLY + a mode=ro URI): a normal
        // Kip\Database would set WAL and create a missing file, and the
        // database, not this keyword gate, is what refuses writes.
        $ro = Kip\Admin\ReadOnlyConnection::fromDsn($config['db']['dsn'] ?? '');
        if ($ro === null) {
            fwrite(STDERR, "Usage: kip db [\"SELECT ...\"|\"PRAGMA ...\"] (needs a file-backed SQLite database)\n");
            exit(1);
        }
        $query = $argv[2] ?? '';
        if ($query === '') {
            // The operator view: every user table, the migration ledger included.
            foreach ($ro->tables() as $t) echo $t, "\n";
            return;
        }
        if (preg_match('/^\s*(SELECT|PRAGMA)\b/i', $query) !== 1) {
            fwrite(STDERR, "kip db runs a single read-only SELECT or PRAGMA statement, nothing else.\n");
            exit(1);
        }
        try {
            echo Kip\Admin\ReadOnlyConnection::tsv($ro->select($query));
        } catch (\PDOException $e) {
            // The driver message can quote the query text; strip control bytes
            // so an error line cannot carry terminal controls into a log.
            throw new RuntimeException('query failed: ' . preg_replace('/[\x00-\x1f\x7f]+/', ' ', $e->getMessage()));
        }
    })(),
    'openapi' => (function () use ($config, $argv) {
        // Mirrors App's own namespace selection (ch. 2 + ch. 3): the app
        // namespace first, the framework admin namespace when the panel is
        // enabled AND a database is configured, then the feature source when
        // the Features directory exists. An explicit feature_namespace => null
        // keeps the feature form off, the same array_key_exists rule App uses.
        $appDir = $config['app_dir'] ?? '.';
        $ns = $config['controller_namespace'] ?? 'App\\Controllers\\';
        if (!str_starts_with($ns, 'App\\')) {
            throw new RuntimeException("controller_namespace {$ns} is not App\\-rooted; kip openapi maps App\\ namespaces onto app_dir/src (PSR-4)");
        }
        $rel = trim(str_replace('\\', '/', substr($ns, strlen('App\\'))), '/');
        $sources = [$ns => $appDir . '/src' . ($rel !== '' ? '/' . $rel : '')];
        if (($config['admin']['enabled'] ?? false) && isset($config['db']['dsn'])) {
            $sources['Kip\\Admin\\Controllers\\'] = dirname((new ReflectionClass(Kip\Admin\Controllers\AdminController::class))->getFileName());
        }
        $featuresDir = $config['features_dir'] ?? (is_dir($appDir . '/Features') ? $appDir . '/Features' : '');
        $featureSources = [];
        if ($featuresDir !== '' && is_dir($featuresDir)) {
            $featureNs = array_key_exists('feature_namespace', $config) ? $config['feature_namespace'] : 'App\\Features\\';
            if (is_string($featureNs)) $featureSources[$featureNs] = $featuresDir;
        }
        $doc = (new Kip\OpenApi($sources, (string) ($config['openapi_title'] ?? 'Kip API'), $featureSources))->generate();
        $out = $argv[2] ?? dirname(__DIR__) . '/openapi.json';
        $json = json_encode($doc, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n";
        if (@file_put_contents($out, $json) === false) {
            throw new RuntimeException("Cannot write {$out}");
        }
        printf("Wrote %s (%d paths)\n", $out, count($doc['paths']));
    })(),
    'make:feature' => (function () use ($config, $argv, $plain_controller_dir) {
        $name = $argv[2] ?? '';
        if ($name === '') {
            fwrite(STDERR, "Usage: kip make:feature <Name>\n");
            exit(1);
        }
        $appDir = $config['app_dir'];
        // ONE features root: app_dir/Features, the same root the migration
        // commands discover. A features_dir pointing elsewhere would emit
        // migrations kip migrate never reads, so it is a refusal, not a guess.
        $configured = $config['features_dir'] ?? null;
        if (is_string($configured) && rtrim($configured, '/') !== rtrim($appDir . '/Features', '/')) {
            throw new RuntimeException("config.php sets features_dir to {$configured}; kip make: scaffolds only {$appDir}/Features, the one root kip migrate reads. Point features_dir back or scaffold by hand.");
        }
        $fn = array_key_exists('feature_namespace', $config) ? $config['feature_namespace'] : 'App\\Features\\';
        if (!is_string($fn)) {
            throw new RuntimeException('config.php sets feature_namespace => null (feature routing off); kip make:feature would emit a controller that can never route.');
        }
        $root = dirname(__DIR__);
        $created = Kip\Scaffold::feature($name, $appDir . '/Features', $fn, [
            'plain_controller_dir' => $plain_controller_dir(),
            'app_views_dir' => $config['views'] ?? $appDir . '/views',
            'reserved_studly' => ($config['admin']['enabled'] ?? false) ? ['Admin'] : [],
        ]);
        $studly = Kip\Routing\Router::studly($name);
        foreach ($created as $path) echo 'Created: ' . Kip\Scaffold::relative($path, $root) . "\n";
        echo 'Route: ' . Kip\Scaffold::routeFor($name) . " ({$studly}Controller::index)\n";
        // Advisory only (files exist and lint either way): when the app's own
        // autoloader would look for the generated class somewhere else, say so,
        // the ch. 3 fix is one psr-4 line plus composer dump-autoload.
        $composer = $root . '/composer.json';
        $fqcn = $fn . $studly . '\\' . $studly . 'Controller';
        if (is_file($composer) && !in_array($appDir . '/Features/' . $studly . '/' . $studly . 'Controller.php', Kip\Scaffold::autoloadPaths($composer, $fqcn), true)) {
            echo "Note: composer.json's autoload would look for {$fqcn} elsewhere; add a psr-4 prefix for app/Features and run composer dump-autoload (guide ch. 3).\n";
        }
    })(),
    'make:controller' => (function () use ($config, $argv, $plain_controller_dir) {
        $name = $argv[2] ?? '';
        if ($name === '') {
            fwrite(STDERR, "Usage: kip make:controller <Name>\n");
            exit(1);
        }
        $namespace = $config['controller_namespace'] ?? 'App\\Controllers\\';
        $created = Kip\Scaffold::controller(
            $name,
            is_string($namespace) ? $namespace : 'App\\Controllers\\',
            $plain_controller_dir(),
            $config['views'] ?? $config['app_dir'] . '/views',
            $config['app_dir'] . '/Features',
        );
        foreach ($created as $path) echo 'Created: ' . Kip\Scaffold::relative($path, dirname(__DIR__)) . "\n";
        echo 'Route: ' . Kip\Scaffold::routeFor($name) . ' (' . Kip\Routing\Router::studly($name) . "Controller::index)\n";
    })(),
    'make:migration' => (function () use ($config, $argv, $migration_dirs) {
        $label = null;
        $feature = null;
        foreach (array_slice($argv, 2) as $arg) {
            if (preg_match('/^--feature=(.+)$/', $arg, $m)) { $feature = $m[1]; continue; }
            $label = $arg;
        }
        if ($label === null) {
            fwrite(STDERR, "Usage: kip make:migration <label> [--feature=<Name>]\n");
            exit(1);
        }
        $appDir = $config['app_dir'];
        $dirs = $migration_dirs();
        $target = $dirs[0]; // the app's own migrations directory
        if ($feature !== null) {
            $studly = Kip\Routing\Router::studly($feature);
            foreach (scandir($appDir . '/Features') ?: [] as $entry) { // folders are Studly; resolve case-insensitively
                if ($entry !== '.' && $entry !== '..' && strcasecmp($entry, $studly) === 0) { $studly = $entry; break; }
            }
            if (!is_dir($appDir . '/Features/' . $studly)) {
                throw new RuntimeException("no feature {$studly} under {$appDir}/Features; run: kip make:feature {$studly} first");
            }
            $target = $appDir . '/Features/' . $studly . '/migrations';
            if (!in_array($target, $dirs, true)) $dirs[] = $target; // numbering spans the WHOLE ledger
        } elseif (getcwd() !== false && str_starts_with(getcwd(), $appDir . '/Features/')) {
            $head = strtok(substr((string) getcwd(), strlen($appDir . '/Features') + 1), '/'); // run from inside a feature: target it
            if (is_string($head) && $head !== '') {
                $target = $appDir . '/Features/' . $head . '/migrations';
                if (!in_array($target, $dirs, true)) $dirs[] = $target;
            }
        }
        // Names already recorded in _migrations, read strictly read-only (a
        // deleted migration's ledger row must not be regenerated: migrate
        // would silently skip the new file). Best effort: no database file
        // yet, or a non-SQLite app, means no ledger to consult.
        $applied = [];
        $dsn = $config['db']['dsn'] ?? null;
        if (is_string($dsn) && str_starts_with($dsn, 'sqlite:')) {
            $dbFile = substr($dsn, 7);
            if (is_file($dbFile)) {
                try {
                    $ro = new PDO('sqlite:file:' . $dbFile . '?mode=ro', null, null, [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
                    $applied = $ro->query('SELECT name FROM _migrations')->fetchAll(PDO::FETCH_COLUMN);
                } catch (\Throwable) { $applied = []; } // no _migrations table yet: nothing was ever applied
            }
        }
        $path = Kip\Scaffold::migration($label, $dirs, $target, $applied);
        echo 'Created: ' . Kip\Scaffold::relative($path, dirname(__DIR__)) . "\n";
    })(),
    'schedule' => (function () use ($config, $argv) {
        // app/schedule.php: a map of cron expression => a kip command
        // string, a callable, or a list of those (guide ch. 8 owns the
        // format). Plain listing shows every entry with its next due time;
        // --due is the crontab mode, it runs only entries matching the
        // current minute under a lock so overlapping invocations no-op.
        $mode = $argv[2] ?? '';
        if ($mode !== '' && $mode !== '--due') {
            fwrite(STDERR, "Usage: kip schedule [--due]\n");
            exit(1);
        }
        $scheduler = new Kip\Cron\Scheduler($config['app_dir'], __FILE__);
        exit($mode === '--due'
            ? $scheduler->runDue(new DateTimeImmutable('now'))
            : $scheduler->listing(new DateTimeImmutable('now')));
    })(),
    'build' => (function () {
        // Manual, local, opt-in; the only place Docker can ever appear in a
        // Kip app, and only because a human typed this command (guide ch. 10
        // documents both deployment paths). Prepare, compile, smoke.
        $appRoot = dirname(__DIR__);
        $buildDir = $appRoot . '/build';
        $staging = (new Kip\Build\Preparer($appRoot, $buildDir . '/staging'))->prepare();
        echo "Prepared app copy: {$staging}\n";
        $artifact = (new Kip\Build\Compiler($staging, $buildDir))->compile();
        echo "Built single-file artifact: {$artifact}\n";
        $smoke = (new Kip\Build\Smoke($artifact, $buildDir . '/smoke'))->run();
        printf(
            "Smoke: route %s answered HTTP %d on port %d; migrate exited %d against %s\n",
            $smoke['http']['route'],
            $smoke['http']['status'],
            $smoke['port'],
            $smoke['migrate']['exit'],
            $smoke['migrate']['data_dir']
        );
        echo "Artifact ready: {$artifact}\n";
    })(),
    default => print("Usage: kip [migrate|rollback|serve|logs|logs:prune|backup|user:create <email> [password] [--admin]|queue:work [--once]|db [\"SELECT ...\"]|openapi [file]|make:feature <Name>|make:controller <Name>|make:migration <label> [--feature=<Name>]|schedule [--due]|build]\n"),
    };
} catch (\Throwable $e) {
    // A failed deploy needs a stated failure, not a stack trace on stdout.
    // Exit 1 matches every argument-validation arm; docs/guide/08-cli.md owns
    // the contract.
    fwrite(STDERR, 'kip: ' . $e::class . ': ' . $e->getMessage() . \PHP_EOL);
    exit(1);
}
