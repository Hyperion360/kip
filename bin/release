#!/usr/bin/env php
<?php // bin/release - combine changelog.d fragments into CHANGELOG.md and tag.
// Usage: bin/release <version> [--dry-run]   (version like 0.5.1; the human decides it)
$version = $argv[1] ?? '';
$dry = in_array('--dry-run', $argv, true);
if (!preg_match('/^\d+\.\d+\.\d+$/', $version)) {
    fwrite(STDERR, "usage: bin/release <x.y.z> [--dry-run]\n"); exit(1);
}
$tag = "v{$version}";
$root = dirname(__DIR__);
exec('git -C ' . escapeshellarg($root) . ' status --porcelain', $dirty, $code);
if ($code !== 0) { fwrite(STDERR, "git status failed\n"); exit(1); }
if ($dirty !== []) { fwrite(STDERR, "working tree is dirty; commit or stash first\n"); exit(1); }
exec('git -C ' . escapeshellarg($root) . " tag -l " . escapeshellarg($tag), $exists);
if ($exists !== []) { fwrite(STDERR, "tag {$tag} already exists\n"); exit(1); }
$fragDir = $root . '/changelog.d';
$frags = is_dir($fragDir) ? array_filter(scandir($fragDir), fn($f) => str_ends_with($f, '.md')) : [];
if ($frags === []) { fwrite(STDERR, "no changelog.d/*.md fragments; nothing to release\n"); exit(1); }
sort($frags);
$byType = [];
$consumed = 0;
$ingest = function (string $line, string $origin) use (&$byType): void {
    [$type, $text] = array_pad(explode(':', $line, 2), 2, '');
    $type = trim($type); $text = trim($text);
    if ($text === '' || !in_array($type, ['Added', 'Changed', 'Fixed', 'Security', 'Deprecated', 'Removed'], true)) {
        fwrite(STDERR, "{$origin} must start with one of Added/Changed/Fixed/Security/Deprecated/Removed:\n{$line}\n"); exit(1);
    }
    $byType[$type][] = "- {$text}";
};
foreach ($frags as $f) {
    $line = trim((string) file_get_contents($fragDir . '/' . $f));
    if ($line === '') continue;
    // A lone CR separates lines just as LF does (CommonMark renders both), so
    // a CR-separated fragment is a forged second line, not a long one-liner.
    if (strpbrk($line, "\r\n") !== false) { fwrite(STDERR, "fragment {$f} must be exactly one line\n"); exit(1); }
    // fragment format: "Added: ..." | "Changed: ..." | "Fixed: ..." | "Security: ..." | "Deprecated: ..." | "Removed: ..."
    $ingest($line, "fragment {$f}");
    $consumed++;
}
$log = $root . '/CHANGELOG.md';
$current = is_file($log) ? (string) file_get_contents($log) : "# Changelog\n";
// A seeded [Unreleased] body (a CHANGELOG that predates fragments carries real entries) is MERGED
// into this release, not stranded beneath it as a second set of type headings. The body pattern
// is .*? (not .+?) so an empty Unreleased matches zero-length instead of spilling into the next
// section, which the strip would then delete.
if (preg_match('/## \[Unreleased\]\n(.*?)(?=\n## |\z)/s', $current, $seed) && trim($seed[1]) !== '') {
    $seedType = '';
    foreach (array_filter(array_map('trim', explode("\n", $seed[1]))) as $ln) {
        if (preg_match('/^### (\w+)$/', $ln, $m)) { $seedType = $m[1]; continue; }
        if (str_starts_with($ln, '- ') && $seedType !== '') {
            $ingest("{$seedType}: " . substr($ln, 2), "seeded Unreleased entry under ### {$seedType}");
        }
    }
    $current = (string) preg_replace('/(## \[Unreleased\]\n).*?(?=\n## |\z)/s', '$1', $current, 1);
}
// Sits AFTER the seed merge: blank fragments beside a seeded [Unreleased] are a
// real release (the seed supplies the entries); blank input with no seed is not.
if ($byType === []) {
    fwrite(STDERR, "no entries; nothing to release\n"); exit(1);
}
$section = "## [{$version}] - " . date('Y-m-d') . "\n";
foreach (['Security', 'Added', 'Changed', 'Deprecated', 'Removed', 'Fixed'] as $type) {
    if (isset($byType[$type])) $section .= "\n### {$type}\n" . implode("\n", $byType[$type]) . "\n";
}
$needle = "## [Unreleased]";
// First occurrence only (prose or a quoted heading later in the file must not double-insert).
// The section goes in through preg_replace_callback so fragment text stays literal: in a
// replacement string $1 and ${2} are backreferences, and a fragment like
// "Fixed: preserve $1 in Redirects patterns" would silently lose them in the written file.
$ins = $needle . "\n\n" . rtrim($section);
$unreleased = str_contains($current, $needle)
    ? preg_replace_callback('/' . preg_quote($needle, '/') . '/', fn () => $ins, $current, 1)
    : preg_replace_callback('/^(# Changelog\n)/', fn ($m) => $m[1] . "\n" . $ins . "\n", $current, 1);
if ($unreleased === null || $unreleased === $current) {
    fwrite(STDERR, "could not place the section under Unreleased; check CHANGELOG.md shape\n"); exit(1);
}
echo "=== {$tag} ===\n" . $section . "\n(fragments consumed: {$consumed})\n";
if ($dry) { echo "dry run: nothing written\n"; exit(0); }
file_put_contents($log, $unreleased);
foreach ($frags as $f) {
    if (!unlink($fragDir . '/' . $f)) { fwrite(STDERR, "could not delete fragment {$f}\n"); exit(1); }
}
chdir($root);
// Staged, checked steps (a failed add must never cascade into an empty commit + orphan tag):
exec('git add CHANGELOG.md changelog.d', $o1, $c1);
if ($c1 !== 0) { fwrite(STDERR, "git add failed\n"); exit(1); }
exec('git commit -m ' . escapeshellarg("chore: release {$tag}"), $o2, $c2); // no --allow-empty: the commit always carries content
if ($c2 !== 0) {
    // Fragments were committed at HEAD before this run started, so a hard
    // reset only discards this run's staged release changes. Nothing is lost.
    fwrite(STDERR, "git commit failed\nrecover with: git reset --hard HEAD\n"); exit(1);
}
// core.commentChar moves git's comment marker off '#', so the ### type headings survive the
// tag message cleanup and git show vN is self-contained (no section line can start with '@').
// The cap is bytes; trim an incomplete UTF-8 tail so a multibyte character is never cut in
// half in the permanent tag message (a character is at most 4 bytes, so the loop runs at
// most three times; preg_match returns false, not 0, on an invalid subject, hence !== 1).
$notes = substr($section, 0, 2000);
while ($notes !== '' && preg_match('//u', $notes) !== 1) {
    $notes = substr($notes, 0, -1);
}
exec('git -c core.commentChar=@ tag -a ' . escapeshellarg($tag) . ' -m ' . escapeshellarg("Release {$tag}\n\n" . $notes), $o3, $c3);
if ($c3 !== 0) {
    // The release commit is HEAD; the tree is clean. A rerun would refuse
    // (fragments consumed), so tagging is a manual, named step.
    fwrite(STDERR, "git tag failed\nrecover with: git tag -a {$tag} -m <release notes> HEAD\n"); exit(1);
}
echo "tagged {$tag}. Review the notes above, then: git push origin main --tags (owner gate)\n";
